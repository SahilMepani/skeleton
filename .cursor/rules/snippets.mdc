			<?php endif; ?>
		</div>
		<?php
	endforeach;
endif;
?>
```

## WP Query Loop

```php
<?php
$args = array(
	'post_type'      => 'post',
	'post_status'    => 'publish',
	'posts_per_page' => 6,
	'no_found_rows'  => true,  // Disable pagination count for performance
);

$query = new WP_Query( $args );

if ( $query->have_posts() ) :
	while ( $query->have_posts() ) :
		$query->the_post();
		?>
		<article <?php post_class(); ?>>
			<?php the_title( '<h2>', '</h2>' ); ?>
		</article>
		<?php
	endwhile;
	wp_reset_postdata();
endif;
?>
```

## Taxonomy Query

```php
<?php
$categories = get_field( 'categories' );  // ACF taxonomy field

$args = array(
	'post_type'      => 'post',
	'post_status'    => 'publish',
	'posts_per_page' => -1,
	'no_found_rows'  => true,
);

if ( is_array( $categories ) && ! empty( $categories ) ) {
	$args['tax_query'] = array(  // phpcs:ignore
		array(
			'taxonomy' => 'category',
			'terms'    => $categories,
			'field'    => 'id',
		),
	);
}

$query = new WP_Query( $args );
?>
```

