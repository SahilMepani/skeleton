# JavaScript Standards (WordPress)

## WordPress JavaScript Coding Standards

Follow the official [WordPress JavaScript Coding Standards](https://developer.wordpress.org/coding-standards/wordpress-coding-standards/javascript/).

## Critical Rules

### 1. Use Strict Mode
```javascript
// ✅ Always start with 'use strict'
( function() {
    'use strict';

    // Code here
} )();
```

### 2. IIFE Pattern (Immediately Invoked Function Expression)
```javascript
// ✅ Correct - Wrap all code in IIFE
( function() {
    'use strict';

    const init = () => {
        // Initialize
    };

    document.addEventListener( 'DOMContentLoaded', init );
} )();

// ❌ Wrong - Global scope pollution
const init = () => {
    // This is in global scope!
};
document.addEventListener( 'DOMContentLoaded', init );
```

### 3. No Inline Event Handlers
```php
// ❌ NEVER do this
<button onclick="handleClick()">Click</button>
<a href="#" onmouseover="doSomething()">Hover</a>

// ✅ Always use addEventListener
<button class="js-button" data-action="submit">Click</button>
```

```javascript
const button = document.querySelector( '.js-button' );
button.addEventListener( 'click', handleClick );
```

## Spacing Rules

### Spaces Inside Parentheses
```javascript
// ✅ Correct - Spaces inside parentheses for control structures
if ( condition ) { }
for ( let i = 0; i < 10; i++ ) { }
while ( condition ) { }
switch ( value ) { }

// ✅ Correct - Spaces in function calls
functionName( arg1, arg2 );
document.querySelector( '.selector' );
element.addEventListener( 'click', handler );
console.log( 'message' );

// ❌ Wrong - No spaces
if (condition) { }
functionName(arg1, arg2);
document.querySelector('.selector');
```

### Spaces Around Operators
```javascript
// ✅ Correct
const result = a + b;
const isValid = value === true;
const fullName = firstName + ' ' + lastName;
const items = [ 1, 2, 3 ];

// ❌ Wrong
const result=a+b;
const isValid=value===true;
```

### Array & Object Spacing
```javascript
// ✅ Correct - Spaces inside brackets
const array = [ 1, 2, 3 ];
const object = { key: 'value' };

// Multi-line
const config = {
    option1: true,
    option2: 'value',
    option3: [ 1, 2, 3 ],
};

// ❌ Wrong
const array = [1,2,3];
const object = {key:'value'};
```

## Variable Declarations

### Use const and let (Never var)
```javascript
// ✅ Correct
const CONSTANT_VALUE = 'immutable';
const element = document.querySelector( '.element' );

let counter = 0;
let isActive = false;

// ❌ Wrong - Never use var
var element = document.querySelector( '.element' );
var counter = 0;
```

### Const by Default
```javascript
// ✅ Use const unless you need to reassign
const items = [];
items.push( 'item' ); // ✅ OK - mutating array, not reassigning

let counter = 0;
counter++; // ✅ OK - reassigning value

// ❌ Wrong - Using let when const would work
let element = document.querySelector( '.element' );
// element is never reassigned
```

## Functions

### Arrow Functions (Preferred)
```javascript
// ✅ Preferred - Arrow functions
const handleClick = ( event ) => {
    event.preventDefault();
    // Handle click
};

const formatPrice = ( price ) => `$${price.toFixed( 2 )}`;

const sum = ( a, b ) => a + b;

// ✅ Also acceptable - Named functions for hoisting
function initializeComponent() {
    // Setup
}
```

### Early Returns
```javascript
// ✅ Correct - Early returns for cleaner code
const processData = ( data ) => {
    if ( ! data ) return null;
    if ( ! data.items ) return null;
    if ( data.items.length === 0 ) return [];

    return data.items.map( processItem );
};

// ❌ Wrong - Nested conditionals
const processData = ( data ) => {
    if ( data ) {
        if ( data.items ) {
            if ( data.items.length > 0 ) {
                return data.items.map( processItem );
            }
            return [];
        }
        return null;
    }
    return null;
};
```

## DOM Manipulation

### Selecting Elements
```javascript
// ✅ Correct
const element = document.querySelector( '.selector' );
const elements = document.querySelectorAll( '.selector' );
const byId = document.getElementById( 'element-id' );

// With null check
const element = document.querySelector( '.selector' );
if ( ! element ) return;
```

### Creating Elements
```javascript
const createCard = ( data ) => {
    const card = document.createElement( 'article' );
    card.className = 'card';
    card.innerHTML = `
        <h2 class="card__title">${escapeHtml( data.title )}</h2>
        <p class="card__content">${escapeHtml( data.content )}</p>
    `;
    return card;
};

// Helper for escaping HTML
const escapeHtml = ( str ) => {
    const div = document.createElement( 'div' );
    div.textContent = str;
    return div.innerHTML;
};
```

### Event Handling
```javascript
// ✅ Correct - Named handler function
const handleSubmit = ( event ) => {
    event.preventDefault();
    const form = event.currentTarget;
    const data = new FormData( form );
    // Process form
};

form.addEventListener( 'submit', handleSubmit );

// Event delegation
document.addEventListener( 'click', ( event ) => {
    const button = event.target.closest( '.js-button' );
    if ( ! button ) return;

    handleButtonClick( button );
} );
```

## Async Operations

### Async/Await (Preferred)
```javascript
// ✅ Correct - async/await
const fetchData = async ( url ) => {
    try {
        const response = await fetch( url );

        if ( ! response.ok ) {
            throw new Error( `HTTP error! status: ${response.status}` );
        }

        return await response.json();
    } catch ( error ) {
        console.error( 'Fetch error:', error );
        return null;
    }
};

// ❌ Avoid - Promise chains (unless necessary)
const fetchData = ( url ) => {
    return fetch( url )
        .then( response => response.json() )
        .then( data => data )
        .catch( error => console.error( error ) );
};
```

### WordPress AJAX
```javascript
const submitForm = async ( formData ) => {
    try {
        const response = await fetch( skeletonData.ajaxUrl, {
            method: 'POST',
            credentials: 'same-origin',
            body: new URLSearchParams( {
                action: 'skeleton_submit_form',
                nonce: skeletonData.nonce,
                ...Object.fromEntries( formData ),
            } ),
        } );

        const data = await response.json();

        if ( ! data.success ) {
            throw new Error( data.data.message || 'Unknown error' );
        }

        return data.data;
    } catch ( error ) {
        console.error( 'AJAX error:', error );
        throw error;
    }
};
```

## DOM Ready Patterns

### Standard Pattern
```javascript
( function() {
    'use strict';

    const init = () => {
        initNavigation();
        initForms();
        initCarousels();
    };

    if ( document.readyState === 'loading' ) {
        document.addEventListener( 'DOMContentLoaded', init );
    } else {
        init();
    }
} )();
```

### With jQuery (When Required)
```javascript
// If jQuery is required by WordPress/plugins
( function( $ ) {
    'use strict';

    const init = () => {
        // Use vanilla JS where possible
        const element = document.querySelector( '.element' );

        // Use jQuery only when necessary
        $( '.jquery-plugin' ).somePlugin();
    };

    $( document ).ready( init );
} )( jQuery );
```

## Classes

### ES6 Class Pattern
```javascript
class Accordion {
    constructor( element ) {
        this.element = element;
        this.buttons = element.querySelectorAll( '.accordion__button' );
        this.allowMultiple = element.dataset.allowMultiple === 'true';

        this.init();
    }

    init() {
        this.buttons.forEach( ( button ) => {
            button.addEventListener( 'click', this.handleClick.bind( this ) );
        } );
    }

    handleClick( event ) {
        const button = event.currentTarget;
        const isExpanded = button.getAttribute( 'aria-expanded' ) === 'true';

        if ( ! this.allowMultiple ) {
            this.closeAll();
        }

        this.toggle( button, ! isExpanded );
    }

    toggle( button, expand ) {
        const content = document.getElementById(
            button.getAttribute( 'aria-controls' )
        );

        button.setAttribute( 'aria-expanded', expand );
        content.hidden = ! expand;
    }

    closeAll() {
        this.buttons.forEach( ( button ) => {
            this.toggle( button, false );
        } );
    }
}

// Initialize
document.querySelectorAll( '.accordion' ).forEach( ( element ) => {
    new Accordion( element );
} );
```

## Error Handling

### Try/Catch Pattern
```javascript
const safeJsonParse = ( jsonString ) => {
    try {
        return JSON.parse( jsonString );
    } catch ( error ) {
        console.error( 'JSON parse error:', error );
        return null;
    }
};

const handleFormSubmit = async ( form ) => {
    const submitButton = form.querySelector( '[type="submit"]' );

    try {
        submitButton.disabled = true;
        submitButton.textContent = 'Submitting...';

        const response = await submitForm( new FormData( form ) );
        showSuccess( response.message );

    } catch ( error ) {
        showError( error.message || 'An error occurred' );

    } finally {
        submitButton.disabled = false;
        submitButton.textContent = 'Submit';
    }
};
```

## Module Pattern (For Complex Features)

```javascript
const Navigation = ( () => {
    'use strict';

    // Private variables
    let isOpen = false;
    let menuButton = null;
    let menuPanel = null;

    // Private methods
    const handleKeydown = ( event ) => {
        if ( event.key === 'Escape' && isOpen ) {
            close();
        }
    };

    const handleOutsideClick = ( event ) => {
        if ( isOpen && ! menuPanel.contains( event.target ) &&
             ! menuButton.contains( event.target ) ) {
            close();
        }
    };

    // Public methods
    const init = () => {
        menuButton = document.querySelector( '.js-menu-toggle' );
        menuPanel = document.querySelector( '.js-menu-panel' );

        if ( ! menuButton || ! menuPanel ) return;

        menuButton.addEventListener( 'click', toggle );
        document.addEventListener( 'keydown', handleKeydown );
        document.addEventListener( 'click', handleOutsideClick );
    };

    const toggle = () => {
        isOpen ? close() : open();
    };

    const open = () => {
        isOpen = true;
        menuButton.setAttribute( 'aria-expanded', 'true' );
        menuPanel.hidden = false;
    };

    const close = () => {
        isOpen = false;
        menuButton.setAttribute( 'aria-expanded', 'false' );
        menuPanel.hidden = true;
    };

    // Public API
    return {
        init,
        open,
        close,
        toggle,
    };
} )();

// Initialize
Navigation.init();
```

## Common Anti-Patterns

### ❌ Never Do This
```javascript
// Global variables
myGlobalVar = 'bad';

// Using var
var element = document.querySelector( '.element' );

// Inline handlers in HTML
<button onclick="doSomething()">

// No spaces in control structures
if(condition){doSomething()}

// Not handling errors
fetch( url ).then( r => r.json() ).then( data => console.log( data ) );

// Modifying native prototypes
Array.prototype.myMethod = function() {};

// Using eval
eval( 'code' );

// document.write
document.write( '<div>content</div>' );
```

### ✅ Do This Instead
```javascript
// IIFE with strict mode
( function() {
    'use strict';

    const localVar = 'good';

    // Use const/let
    const element = document.querySelector( '.element' );

    // Event listeners
    element.addEventListener( 'click', handleClick );

    // Proper spacing
    if ( condition ) {
        doSomething();
    }

    // Error handling
    try {
        const data = await fetch( url ).then( r => r.json() );
        console.log( data );
    } catch ( error ) {
        console.error( error );
    }
} )();
```

## Accessibility Considerations

```javascript
// Focus management
const openModal = ( modal ) => {
    modal.hidden = false;
    modal.setAttribute( 'aria-hidden', 'false' );

    // Focus first focusable element
    const firstFocusable = modal.querySelector(
        'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
    );
    firstFocusable?.focus();
};

// Announce dynamic content
const announceMessage = ( message ) => {
    const liveRegion = document.querySelector( '[aria-live]' );
    if ( liveRegion ) {
        liveRegion.textContent = message;
    }
};

// Keyboard navigation
const handleKeydown = ( event ) => {
    switch ( event.key ) {
        case 'ArrowDown':
            event.preventDefault();
            focusNextItem();
            break;
        case 'ArrowUp':
            event.preventDefault();
            focusPreviousItem();
            break;
        case 'Escape':
            closeMenu();
            break;
    }
};
```
